# ---------------------------------------------------------------------------
# Perception — environment template
#
# You probably do not need to read this file. `npm run setup` writes a working
# .env for you, generating the keys rather than asking you to paste them:
#
#     npm install && npm run setup && npm run dev
#
# This file is the reference for what each variable does, for when you start
# pointing channels at real services. See docs/RUNNING.md to get started and
# docs/PRODUCTION.md before deploying.
#
#     cp .env.example .env      # then, at minimum, set DATABASE_URL
#
# .env and .env.local are gitignored. Never commit real credentials.
#
# Only DATABASE_URL is genuinely required — the app stores everything in
# Postgres and has no in-memory mode. TOKEN_ENCRYPTION_KEY is required before
# any social account can be connected. Everything else degrades: without
# REDIS_URL nothing scheduled runs, without a sender no campaign leaves.
# ---------------------------------------------------------------------------


# --- Core ------------------------------------------------------------------

# Public base URL of the app; used for OAuth redirects and tracked links.
APP_URL="http://localhost:3000"


# --- Database (Prisma / PostgreSQL) ----------------------------------------

# Required. See prisma/schema.prisma for the model.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/perception?schema=public"

# Where uploaded media is written on local disk. Production uses S3 instead.
MEDIA_ROOT="./.media"


# --- Jobs & scheduling (Redis / BullMQ) ------------------------------------

# Backs the publish queue, metrics sync, and token-health scheduler.
REDIS_URL="redis://localhost:6379"


# --- Media storage (S3-compatible + CDN) -----------------------------------

S3_REGION="us-east-1"
S3_BUCKET="perception-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optional: custom endpoint for non-AWS providers (R2, MinIO, Spaces).
S3_ENDPOINT=""
# Public CDN origin that serves objects from the bucket.
CDN_BASE_URL=""


# --- Security --------------------------------------------------------------

# 32-byte key (base64) for envelope-encrypting platform OAuth tokens at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# Secret used to sign sessions / auth cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""


# --- Email delivery (Resend) -----------------------------------------------
#
# These are the fallback. Credentials saved per organisation in Settings →
# Sending win over them, which is how one deployment serves several businesses
# sending from their own domains.

RESEND_API_KEY=""

# The verified sending identity. The domain must pass SPF, DKIM and DMARC
# before Resend will accept a send.
RESEND_FROM="hello@yourdomain.com"

# Signing secret for delivery/open/bounce webhooks, from the Resend dashboard.
# Set it: an unverified webhook is an open endpoint that writes to your
# delivery table.
RESEND_WEBHOOK_SECRET=""


# --- SMS delivery (Twilio) -------------------------------------------------
#
# US traffic requires 10DLC brand and campaign registration before anything
# sends. The app models that as a setup cost with its own line item rather
# than folding it into the per-message rate.

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM="+15005550006"

# Where Twilio posts inbound texts and delivery receipts. Both must be
# publicly reachable, and both verify Twilio's signature before doing anything.
TWILIO_INBOUND_URL="https://yourdomain.com/api/webhooks/twilio/inbound"
TWILIO_STATUS_URL="https://yourdomain.com/api/webhooks/twilio/status"


# --- Live connections (real OAuth) -----------------------------------------
# Set these two and the connect flow in Connections becomes real. The setup
# panel there prints the exact redirect URI to register with each platform.
#
# Bluesky needs NEITHER of the credentials below — it authenticates with a
# handle and an app password and works the moment TOKEN_ENCRYPTION_KEY is set.
# Optional: point at a self-hosted PDS.
BLUESKY_PDS_URL="https://bsky.social"


# --- Platform connectors ---------------------------------------------------
# Register an app per platform and complete its review process before launch.
# See docs/CONNECTORS.md for the constraint on each.

# Meta — covers both Facebook Pages and Instagram professional accounts.
# Requires Meta App Review for pages_manage_posts, pages_read_engagement,
# and instagram_content_publish.
META_APP_ID=""
META_APP_SECRET=""

# LinkedIn — organization posting requires Marketing Developer Platform access.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Google — Business Profile API access is approved per project.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Second-release connectors (leave blank until enabled) -----------------

# TikTok — unaudited apps are limited to private/draft uploads.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# YouTube — uploads from unaudited API projects stay private until audit.
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# Threads (rides a Meta app, separate credentials in the console)
THREADS_APP_ID=""
THREADS_APP_SECRET=""

# Pinterest
PINTEREST_APP_ID=""
PINTEREST_APP_SECRET=""

# X — posting requires a paid API tier
X_CLIENT_ID=""
X_CLIENT_SECRET=""


# --- Local stand-in servers (`npm run mocks`) ------------------------------
#
# Nine small servers that speak the real wire protocols of the services above,
# so sending and publishing can be exercised end to end without touching
# anybody's production account. The adapter code is identical either way —
# only the hostname changes.
#
# THIS IS THE SWITCH. A channel talks to its stand-in while its _BASE_URL is
# set, and to the real service the moment you delete that one line and put in
# real credentials. There is no flag and no code change.
#
# `npm run setup` writes these; they are listed here for reference.

# RESEND_BASE_URL="http://localhost:4323"
# TWILIO_BASE_URL="http://localhost:4324"
# META_BASE_URL="http://localhost:4325"
# REDDIT_BASE_URL="http://localhost:4327"
# PINTEREST_BASE_URL="http://localhost:4328"
# GBP_BASE_URL="http://localhost:4329"
# Mastodon (4321) and Bluesky (4326) are addressed per-account rather than
# globally: point the handle at localhost when connecting them.
