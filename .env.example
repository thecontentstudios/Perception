# ---------------------------------------------------------------------------
# Perception — environment template
#
# NONE OF THIS IS NEEDED TO RUN THE PROTOTYPE.
# `npm install && npm run dev` works with no configuration at all — the
# clickable prototype runs on an in-memory demo workspace.
#
# This file documents what the production services expect, so the path from
# prototype to production is explicit. Copy it when you start wiring real
# infrastructure:
#
#     cp .env.example .env.local
#
# .env.local is gitignored. Never commit real credentials.
# ---------------------------------------------------------------------------


# --- Core ------------------------------------------------------------------

# Public base URL of the app; used for OAuth redirects and tracked links.
APP_URL="http://localhost:3000"


# --- Database (Prisma / PostgreSQL) ----------------------------------------

# See prisma/schema.prisma for the model.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/perception?schema=public"


# --- Jobs & scheduling (Redis / BullMQ) ------------------------------------

# Backs the publish queue, metrics sync, and token-health scheduler.
REDIS_URL="redis://localhost:6379"


# --- Media storage (S3-compatible + CDN) -----------------------------------

S3_REGION="us-east-1"
S3_BUCKET="perception-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optional: custom endpoint for non-AWS providers (R2, MinIO, Spaces).
S3_ENDPOINT=""
# Public CDN origin that serves objects from the bucket.
CDN_BASE_URL=""


# --- Security --------------------------------------------------------------

# 32-byte key (base64) for envelope-encrypting platform OAuth tokens at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# Secret used to sign sessions / auth cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""


# --- Email delivery --------------------------------------------------------

# One of: ses | postmark | sendgrid | mailgun
EMAIL_PROVIDER="postmark"
EMAIL_API_KEY=""

# The verified sending identity. The domain must pass SPF, DKIM, and DMARC
# before campaigns can send.
EMAIL_FROM_ADDRESS="hello@yourdomain.com"
EMAIL_FROM_NAME="Your Business"

# Physical postal address included in every commercial email footer.
# Required by CAN-SPAM; the email adapter blocks sends without it.
EMAIL_POSTAL_ADDRESS=""


# --- Platform connectors ---------------------------------------------------
# Register an app per platform and complete its review process before launch.
# See docs/CONNECTORS.md for the constraint on each.

# Meta — covers both Facebook Pages and Instagram professional accounts.
# Requires Meta App Review for pages_manage_posts, pages_read_engagement,
# and instagram_content_publish.
META_APP_ID=""
META_APP_SECRET=""

# LinkedIn — organization posting requires Marketing Developer Platform access.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Google — Business Profile API access is approved per project.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Second-release connectors (leave blank until enabled) -----------------

# TikTok — unaudited apps are limited to private/draft uploads.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# YouTube — uploads from unaudited API projects stay private until audit.
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# SMS — US traffic requires 10DLC campaign registration.
SMS_ACCOUNT_SID=""
SMS_AUTH_TOKEN=""
SMS_FROM_NUMBER=""
